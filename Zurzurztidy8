end

lbl("PRIME HUB", UDim2.new(0,0,0,8), UDim2.new(1,0,0,20), Color3.fromRGB(46, 204, 113), 15)
local status = lbl("Status: OFF", UDim2.new(0,0,0,126), UDim2.new(1,0,0,18), Color3.fromRGB(170, 170, 170), 10)

local isSpam, speed, dur = false, 25, 5

local btn = Instance.new("TextButton", f)
btn.Size, btn.Position, btn.Text, btn.BackgroundColor3 = UDim2.new(0.66, 0, 0, 30), UDim2.new(0.06, 0, 0, 45), "trampling: OFF", Color3.fromRGB(30, 30, 35)
