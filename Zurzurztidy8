setBtn.Size, setBtn.Position, setBtn.Text, setBtn.BackgroundColor3 = UDim2.new(0, 28, 0, 30), UDim2.new(0.75, 0, 0, 45), "⚙️", Color3.fromRGB(45, 45, 60)
setBtn.TextColor3, setBtn.TextSize = Color3.fromRGB(255, 255, 255), 13
Instance.new("UICorner", setBtn).CornerRadius = UDim.new(0, 6)

local menu = Instance.new("Frame", f)
menu.Size, menu.Position, menu.BackgroundColor3, menu.Visible = UDim2.new(0.88, 0, 0, 30), UDim2.new(0.06, 0, 0, 85), Color3.fromRGB(20, 20, 30), false
Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 6)

local function mkB(txt, col, x)
    local b = Instance.new("TextButton", menu)
    b.Size, b.Position, b.Text, b.BackgroundColor3 = UDim2.new(0, 30, 0, 22), UDim2.new(0, x, 0.5, -11), txt, col
    b.TextColor3, b.TextSize, b.Font = Color3.fromRGB(255, 255, 255), 11, Enum.Font.GothamBold
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    return b
end

local bP = mkB("+", Color3.fromRGB(0, 150, 255), 6)
local bM = mkB("-", Color3.fromRGB(230, 140, 30), 40)
local bS = mkB("🔍", Color3.fromRGB(100, 50, 200), 74)
local bH = mkB("👁️", Color3.fromRGB(220, 50, 50), 108)

local function stop()
    isSpam = false
    if RootPart then RootPart.Velocity = Vector3.zero end
    btn.BackgroundColor3, btn.Text, status.Text = Color3.fromRGB(30, 30, 35), "trampling: OFF", "Status: OFF"
end

local function start()
    if isSpam then return end
    isSpam = true
    btn.BackgroundColor3, btn.Text, status.Text = Color3.fromRGB(46, 204, 113), "trampling: ON", "Speed: " .. speed .. " ✈️"
    task.spawn(function()
        local t = tick()
        while isSpam and (tick() - t < dur) do
            if RootPart then
                local l = RootPart.CFrame.LookVector
                RootPart.Velocity = l * speed; task.wait(0.05)
                if not isSpam then break end
                RootPart.Velocity = -l * speed; task.wait(0.05)
            else break end
        end
        stop()
    end)
end

btn.MouseButton1Click:Connect(function() if isSpam then stop() else start() end end)
setBtn.MouseButton1Click:Connect(function() menu.Visible = not menu.Visible end)

bP.MouseButton1Click:Connect(function()
    speed = speed + 5
    if isSpam then status.Text = "Speed: " .. speed .. " ✈️" end
end)

bM.MouseButton1Click:Connect(function()
    if speed > 5 then speed = speed - 5 end
    if isSpam then status.Text = "Speed: " .. speed .. " ✈️" end
end)

local small = false
bS.MouseButton1Click:Connect(function()
    small = not small
    if small then
        f.Size = UDim2.new(0, 150, 0, 120)
        btn.Size, setBtn.Size = UDim2.new(0.62, 0, 0, 26), UDim2.new(0, 26, 0, 26)
        setBtn.Position, btn.Position = UDim2.new(0.72, 0, 0, 40), UDim2.new(0.06, 0, 0, 40)
        status.Position = UDim2.new(0, 0, 0, 95)
        menu.Position, menu.Size = UDim2.new(0.06, 0, 0, 70), UDim2.new(0.88, 0, 0, 24)
    else
        f.Size = UDim2.new(0, 190, 0, 150)
        btn.Size, setBtn.Size = UDim2.new(0.66, 0, 0, 30), UDim2.new(0, 28, 0, 30)
        setBtn.Position, btn.Position = UDim2.new(0.75, 0, 0, 45), UDim2.new(0.06, 0, 0, 45)
        status.Position = UDim2.new(0, 0, 0, 126)
        menu.Position, menu.Size = UDim2.new(0.06, 0, 0, 85), UDim2.new(0.88, 0, 0, 30)
    end
end)

local hidden = false
bH.MouseButton1Click:Connect(function()
    hidden = not hidden
    bg.Visible = not hidden
    f.BackgroundTransparency = hidden and 1 or 0
    stroke.Transparency = hidden and 1 or 0
end)
