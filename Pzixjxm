-- دالة للحصول على اسم ملف التخزين الخاص بهذا السيرفر حصرياً
local function getServerCacheFileName()
  local jobId = game.JobId
  if not jobId or jobId == "" then
    jobId = "default_server"
  else
    -- تنظيف الـ JobId ليكون صالحاً كاسم ملف
    jobId = jobId:gsub("[^%w_%-]", "_")
  end
  return "sys_server_cfg_" .. jobId .. ".bin"
end 

local function setTargetDevice(device)
  local fileName = getServerCacheFileName()
  if writefile then
    pcall(writefile, fileName, device)
  end
  _G.TargetDevice = device
end 

local function getTargetDevice()
  if not _G.TargetDevice then
    local fileName = getServerCacheFileName()
    if readfile and isfile and isfile(fileName) then
      pcall(function()
        _G.TargetDevice = readfile(fileName)
      end)
    end
    -- إذا كان هذا السيرفر جديد وليس له ملف محفوظ، يخليه "Mobile" افتراضياً
    if not _G.TargetDevice or _G.TargetDevice == "" then
      _G.TargetDevice = "Mobile"
      setTargetDevice("Mobile")
    end
  end
  return _G.TargetDevice
end 

local function nativeFunctionsIntact()
  if not debug or not debug.getinfo then
    return true
  end
  local fns = {rawset, rawget, pcall}
  if getgc then
    table.insert(fns, getgc)
  end
  for _, fn in ipairs(fns) do
    local info = debug.getinfo(fn)
    if not info or info.what ~= "C" or info.source ~= "=[C]" then
      return false
    end
  end
  return true
end 

