local function ApplyDevice(device)
  local profile = Profiles[device]
  if not profile then return false end
  ActiveProfile = profile
  setTargetDevice(device)

  -- ===== Method 1: hookmetamethod =====
  if not Hooked and typeof(hookmetamethod) == "function" then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
      if ActiveProfile then
        if rawequal(self, UserInputService) then
          local val = ActiveProfile[key]
          if val ~= nil then
            return val
          end
          if key == "GetConnectedGamepads" then
            return function()
              if ActiveProfile.GamepadEnabled then
                return { Enum.UserInputType.Gamepad1 }
              end
              return {}
            end
          end
          if key == "GetDeviceAcceleration" or key == "GetDeviceGravity" or key == "GetDeviceRotation" then
            if not ActiveProfile.AccelerometerEnabled then
              return function() return Vector3.zero end
            end
          end
        elseif rawequal(self, GuiService) then
          if key == "IsTenFootInterface" then
            return function()
              return ActiveProfile.IsTenFootInterface
            end
          end
        end
      end
      return oldIndex(self, key)
    end))
    Hooked = true
  end

  -- ===== Method 2: getgc patch =====
  if typeof(getgc) == "function" then
    task.spawn(function()
      local ok, objs = pcall(getgc, true)
      if not ok or type(objs) ~= "table" then return end

      for i = 1, math.min(#objs, 180000) do
        local obj = objs[i]
        if type(obj) == "table" then
          pcall(function()
            local d = rawget(obj, "Device")
            if d == "Mobile" or d == "PC" or d == "Console" or d == "Desktop" then
              rawset(obj, "Device", device)
            end
            local p = rawget(obj, "Platform")
            if p == "Mobile" or p == "PC" or p == "Console" or p == "Desktop" or p == "Phone" then
              rawset(obj, "Platform", device)
            end
            if rawget(obj, "IsMobile") ~= nil then
              rawset(obj, "IsMobile", device == "Mobile")
            end
            if rawget(obj, "IsConsole") ~= nil then
              rawset(obj, "IsConsole", device == "Console")
            end
            if rawget(obj, "IsPC") ~= nil or rawget(obj, "IsDesktop") ~= nil then
              rawset(obj, "IsPC", device == "PC")
              rawset(obj, "IsDesktop", device == "PC")
            end
          end)
        end
      end
    end)
  end

  return true
end

